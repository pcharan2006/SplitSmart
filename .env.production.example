# Settings for docker-compose.prod.yml.   cp .env.production.example .env.production   then edit.
# NEVER commit .env.production. It holds your real passwords.

# Strong, unique passwords. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DB_ROOT_PASSWORD=
DB_PASSWORD=

# Signs login tokens. 32+ random characters (the server refuses to start with a weak one):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it later logs every user out.
JWT_SECRET=

# The public address people type in their browser, exactly (scheme + domain [+ port], no trailing slash).
# Examples: https://splitsmart.example.com   or, to try it on your own PC: http://localhost:8080
CLIENT_URL=

# Port the website listens on on this machine (put HTTPS in front of it, see docs/DEPLOYMENT.md).
WEB_PORT=8080

# Number of proxies in front of the API: 1 = just the bundled nginx; 2 = nginx plus your own HTTPS proxy.
TRUST_PROXY=1

# Email for password-reset links (any SMTP provider: Brevo, SendGrid, Amazon SES, Resend, Gmail app password ...).
# Without SMTP_HOST, password reset cannot work in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SplitSmart <no-reply@yourdomain.com>

# Optional: AI features.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
