# ---- Server ----
PORT=5000
NODE_ENV=development            # use "production" when deployed

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3307                    # 3307 = the Docker container from docker-compose.yml
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=expense_splitter
# DB_SSL=true                   # set for managed MySQL services (Railway, Aiven, RDS ...) that require encryption

# ---- Auth ----
# In production this must be a long random string (32+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- CORS: the ONE website allowed to call this API (required in production) ----
CLIENT_URL=http://localhost:5173

# ---- Deployment (optional) ----
# TRUST_PROXY=1                 # set to 1 behind a host's proxy/load balancer so rate limits see real visitor IPs
# AUTH_RATE_LIMIT=20            # login/register attempts per IP per 15 min (default: 20 in production, 200 in development)

# ---- Email for password-reset links (optional in development) ----
# Leave SMTP_HOST empty in development: the reset link is then shown on screen instead.
# Production needs a real SMTP provider (Brevo, SendGrid, Amazon SES, Resend, Gmail app password ...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SplitSmart <no-reply@yourdomain.com>

# ---- AI (optional: without a key, chat answers 503 and insights show numbers only) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
