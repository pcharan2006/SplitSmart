{
  "name": "expense-splitter-backend",
  "version": "1.0.0",
  "description": "REST API for the AI-Powered Smart Expense Splitter",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:api": "npx -y newman run postman/ExpenseSplitter.postman_collection.json -e postman/ExpenseSplitter.local.postman_environment.json",
